# NyaySetu Backend Environment Configuration Example
# Copy this file to `backend/.env` and insert your credentials.

# Gnani.ai Voice OS Integration
# Obtain your key from the Gnani.ai Developer Console (https://gnani.ai)
GNANI_API_KEY=your_gnani_api_key_here

# Server Configuration (Optional defaults)
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

